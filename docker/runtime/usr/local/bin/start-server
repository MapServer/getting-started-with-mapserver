#!/bin/bash -e

echo "Starting with apache2"

# save the environment to be able to restore it in the FCGI daemon (used
# in /usr/local/bin/qgis_mapsev_wrapper) for the startup code.
# hide any PassEnv variable _ was undefined warnings
${GET_ENV} | grep -v '^_=' | sed -e 's/^\([^=]*\)=.*/PassEnv \1/' > /tmp/pass-env

# Save the environment to be able to restore it in the FCGI daemon (used in /usr/local/bin/mapserv_wrapper)
${GET_ENV} | sed -e 's/.\+/export "\0"/' > /tmp/init_env

#if [[ "${UID}" == 0 ]]; then
#    echo "Switching listen port to 80"
#    cd /tmp
#    sed -i -e 's/<VirtualHost \*:8080>/<VirtualHost *:80>/' /etc/apache2/sites-available/000-default.conf
#    sed -i -e 's/Listen 8080$/Listen 80/' /etc/apache2/ports.conf
#fi

trap '' WINCH

rm -f "${APACHE_PID_FILE}"

# Warm up mod_fcgid. It only starts a new MapServer process without delay
# when none is busy; otherwise a request waits 1 second for a busy process
# to become free, so short concurrent requests (e.g. GetStyles + GetMap)
# are slow. Sending MIN_PROCESSES requests at once, right after start-up,
# starts that many processes, and FcgidMinProcessesPerClass keeps them alive.
(
    # Wait until Apache accepts connections (up to 30 seconds)
    for _ in $(seq 30); do
        (exec 3<>/dev/tcp/127.0.0.1/8080) 2>/dev/null && break
        sleep 1
    done
    for _ in $(seq "${MIN_PROCESSES}"); do
        (
            exec 3<>/dev/tcp/127.0.0.1/8080 \
                && printf 'GET / HTTP/1.0\r\nHost: localhost\r\n\r\n' >&3 \
                && cat <&3 >/dev/null
        ) &
    done
    wait
) &

exec apache2 -DFOREGROUND
