CLASS
    NAME "Vertical"
    GROUP "Vertical"
    EXPRESSION ("[fclass]" = "residential")
    STYLE
        COLOR "#E08E45"
        # SYMBOL "hatch"
        # ANGLE 90
        WIDTH 0.5
        SIZE 8 # distance between hatch lines in MapServer
        SYMBOL "hatch_vertical"
        WIDTH 0.5
    END
    STYLE
        OUTLINECOLOR "#9D6330"
        WIDTH 2
    END
END

CLASS
    NAME "Horizontal"
    GROUP "Horizontal"
    EXPRESSION ("[fclass]" = "residential")
    STYLE
        COLOR "#E08E45"
        # SYMBOL "hatch"
        # ANGLE 0
        SYMBOL "hatch_horizontal"
        WIDTH 3
        SIZE 12
    END
    STYLE
        OUTLINECOLOR "#9D6330"
        WIDTH 2
    END
END

CLASS
    NAME "Slash"
    GROUP "Slash"
    EXPRESSION ("[fclass]" = "residential")
    STYLE
        COLOR "#E08E45"
        # SYMBOL "hatch"
        # ANGLE 45
        SYMBOL "hatch_slash"
        WIDTH 0.5
        SIZE 8
    END
    STYLE
        OUTLINECOLOR "#9D6330"
        WIDTH 2
    END
END

CLASS
    NAME "Backslash"
    GROUP "Backslash"
    EXPRESSION ("[fclass]" = "residential")
    STYLE
        COLOR "#E08E45"
        # SYMBOL "hatch"
        # ANGLE -45
        SYMBOL "hatch_backslash"
        WIDTH 0.5
        SIZE 8
    END
    STYLE
        OUTLINECOLOR "#9D6330"
        WIDTH 2
    END
END

CLASS
    NAME "Cross"
    GROUP "Cross"
    EXPRESSION ("[fclass]" = "residential")
    STYLE
        COLOR "#E08E45"
        SYMBOL "hatch_horizontal"
        WIDTH 0.5
        SIZE 8
    END
    STYLE
        COLOR "#E08E45"
        SYMBOL "hatch_vertical"
        WIDTH 0.5
        SIZE 8
    END
    STYLE
        OUTLINECOLOR "#9D6330"
        WIDTH 2
    END
END

CLASS
    NAME "Diagonal"
    GROUP "Diagonal"
    EXPRESSION ("[fclass]" = "residential")
    STYLE
        COLOR "#E08E45"
        SYMBOL "hatch_slash"
        WIDTH 0.5
        SIZE 8
    END
    STYLE
        COLOR "#E08E45"
        SYMBOL "hatch_backslash"
        WIDTH 0.5
        SIZE 8
    END
    STYLE
        OUTLINECOLOR "#9D6330"
        WIDTH 2
    END
END