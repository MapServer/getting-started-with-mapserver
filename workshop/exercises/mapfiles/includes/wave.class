CLASS
    GROUP "Horizontal"
    STYLE
        SYMBOL "wave"
        COLOR "#4A90D9"
        WIDTH 1
        SIZE 14
    END
    STYLE
        OUTLINECOLOR 0 0 0
        WIDTH 1
    END
END

CLASS
    GROUP "Vertical"
    STYLE
        SYMBOL "vwave"
        COLOR "#4A90D9"
        WIDTH 1
        SIZE 14
    END
    STYLE
        OUTLINECOLOR 0 0 0
        WIDTH 1
    END
END
